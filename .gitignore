# 依赖目录，由 npm install 生成，不入库
node_modules/

# 构建产物，由 CI 生成，不入库
dist/
dist-ssr/

# 本地环境变量
*.local
.env
.env.*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code 的本地权限配置，跟机器绑定，不进仓库
# （根目录的 CLAUDE.md 是项目文档，要保留）
.claude/settings.local.json

# 系统
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 注意：package-lock.json 必须入库
# CI 里的 `npm ci` 和 `cache: npm` 都依赖它，缺了会直接构建失败
