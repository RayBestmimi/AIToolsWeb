# 依赖目录，由 npm install 生成，不入库
node_modules/

# 构建产物，由 CI 生成，不入库
dist/
dist-ssr/

# 本地环境变量
*.local
.env
.env.*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code 相关的东西全部留在本机，不进公开仓库：
#   .claude/     权限白名单，跟机器和会话绑定，别人拿去也没用
#   CLAUDE.md    内部协作文档，记录"这个项目怎么跟 AI 协作"，不适合对外发布
# 本地文件照常保留，只是不纳入版本控制。
.claude/
CLAUDE.md

# 系统
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 注意：package-lock.json 必须入库
# CI 里的 `npm ci` 和 `cache: npm` 都依赖它，缺了会直接构建失败
